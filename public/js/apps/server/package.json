{
  "name": "@survival/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "../../packages/shared"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.json",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "setup": "npm run db:gen && npm run db:push && npm run seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@survival/shared": "*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.21.4",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
