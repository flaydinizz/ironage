# ============================================================
# SERVER — Variáveis de Ambiente
# Copie para .env e preencha os valores antes de rodar
# ============================================================

# Banco de dados
DB_DIR=./data
DB_FILE=survival.db

# JWT — TROQUE EM PRODUÇÃO para uma string longa e aleatória
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# CORS — URL do cliente Next.js
CLIENT_ORIGIN=http://localhost:3000
